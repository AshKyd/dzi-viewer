{
	"name": "dzi-viewer",
	"version": "0.3.0",
	"description": "Lightweight DOM-based Deep Zoom (DZI) image viewer for Svelte 5 and vanilla JavaScript.",
	"license": "ISC",
	"homepage": "https://github.com/AshKyd/dzi-viewer#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/AshKyd/dzi-viewer.git"
	},
	"bugs": {
		"url": "https://github.com/AshKyd/dzi-viewer/issues"
	},
	"keywords": [
		"svelte",
		"dzi",
		"deep-zoom",
		"openseadragon",
		"image-viewer",
		"pan-zoom"
	],
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*",
		"!dist/**/*.stories.*",
		"!dist/**/*Demo.svelte*",
		"!dist/**/*.mdx"
	],
	"type": "module",
	"sideEffects": [
		"**/*.css"
	],
	"types": "./dist/index.d.ts",
	"svelte": "./dist/index.js",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		},
		"./vanilla": {
			"types": "./dist/vanilla/index.d.ts",
			"import": "./dist/vanilla/index.js",
			"default": "./dist/vanilla/index.js"
		},
		"./DziViewer": {
			"types": "./dist/components/DziViewer/DziViewer.svelte.d.ts",
			"svelte": "./dist/components/DziViewer/DziViewer.svelte"
		},
		"./PanZoom": {
			"types": "./dist/components/PanZoom/PanZoom.svelte.d.ts",
			"svelte": "./dist/components/PanZoom/PanZoom.svelte"
		}
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && npm run prepack",
		"build:vanilla": "vite build --config vite.vanilla.config.ts",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"prepack": "svelte-kit sync && svelte-package && npm run build:vanilla && publint",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "svelte-kit sync && prettier --check . && eslint .",
		"format": "prettier --write .",
		"test": "vitest run",
		"release": "release-it",
		"storybook": "storybook dev -p 6006 --ci",
		"build-storybook": "storybook build"
	},
	"dependencies": {
		"d3-ease": "^3.0.1",
		"d3-interpolate": "^3.0.1"
	},
	"devDependencies": {
		"@chromatic-com/storybook": "^5.6.0",
		"@eslint/js": "^10.0.1",
		"@release-it/conventional-changelog": "^12.0.2",
		"@storybook/addon-a11y": "^10.6.7",
		"@storybook/addon-docs": "^10.6.7",
		"@storybook/addon-svelte-csf": "^5.1.6",
		"@storybook/addon-vitest": "^10.6.7",
		"@storybook/sveltekit": "^10.6.7",
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.2.0",
		"@sveltejs/package": "^3.0.2",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/d3-ease": "^3.0.2",
		"@types/d3-interpolate": "^3.0.4",
		"@types/node": "^24",
		"@vitest/browser-playwright": "^5.0.5",
		"@vitest/coverage-v8": "^5.0.5",
		"eslint": "^10.15.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-storybook": "^10.6.7",
		"eslint-plugin-svelte": "^3.24.1",
		"globals": "^17.14.0",
		"playwright": "^1.65.1",
		"prettier": "^3.10.1",
		"prettier-plugin-svelte": "^4.1.1",
		"publint": "^0.3.25",
		"release-it": "^21.1.2",
		"storybook": "^10.6.7",
		"svelte": "^5.57.3",
		"svelte-akui": "^1.0.1",
		"svelte-check": "^4.7.8",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.2",
		"vite": "^8.3.8",
		"vitest": "^5.0.5"
	},
	"peerDependencies": {
		"svelte": "^5.11.0"
	},
	"peerDependenciesMeta": {
		"svelte": {
			"optional": true
		}
	}
}
