{
	"$schema": "https://unpkg.com/release-it@latest/schema/release-it.json",
	"git": {
		"commitMessage": "chore: release v${version}",
		"tagName": "v${version}"
	},
	"github": {
		"release": true
	},
	"npm": {
		"publish": true
	},
	"hooks": {
		"before:init": ["npm run lint", "npm run check", "npm test"]
	},
	"plugins": {
		"@release-it/conventional-changelog": {
			"preset": {
				"name": "conventionalcommits"
			},
			"infile": "CHANGELOG.md",
			"header": "# Changelog"
		}
	}
}
